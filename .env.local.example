# ── Supabase ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...              # server-only
STRIPE_WEBHOOK_SECRET=whsec_...           # server-only

# ── Site URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zentracollect.co.uk

# ── Web Push / PWA Notifications ───────────────────────────────────────────────
# Generate with: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExamplePublicKeyHere...  # safe to expose to browser
VAPID_PRIVATE_KEY=ExamplePrivateKeyHere...             # server-only, KEEP SECRET
VAPID_SUBJECT=mailto:hello@zentracollect.co.uk

# Secret used to authenticate Vercel Cron requests to /api/push/send
CRON_SECRET=your-random-secret-here                   # server-only, KEEP SECRET

# ── Analytics (optional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zentracollect.co.uk
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
